#!/usr/bin/env php
<?php

declare(strict_types=1);

// Generated files (Unicode tables, compiled containers) need more than PHP's default.
$limit = ini_get('memory_limit');
$bytes = (int) $limit * match (strtolower(substr((string) $limit, -1))) { 'g' => 1 << 30, 'm' => 1 << 20, 'k' => 1 << 10, default => 1 };
if ($bytes > 0 && $bytes < (1 << 30)) {
    ini_set('memory_limit', '1G');
}

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new Ankus\Cli())->run($argv));
