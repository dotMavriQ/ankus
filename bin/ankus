#!/usr/bin/env php
<?php

declare(strict_types=1);

// Relaunch once with the settings analysis wants, unless already done:
//  - Xdebug off: it slows parsing ~3.5x and is common on dev machines.
//  - opcache JIT on: ~20-35% faster parsing, off by default for the CLI.
// ANKUS_NO_RELAUNCH=1 keeps the current process as is.
if (!getenv('ANKUS_NO_RELAUNCH') && function_exists('pcntl_exec')) {
    // XDEBUG_MODE in the environment overrides the ini value, so ask Xdebug itself.
    $xdebug = extension_loaded('xdebug') && (function_exists('xdebug_info') ? xdebug_info('mode') !== [] : ini_get('xdebug.mode') !== 'off');
    $jit = function_exists('opcache_get_status') && !ini_get('opcache.enable_cli');
    if ($xdebug || $jit) {
        $env = getenv();
        $env['ANKUS_NO_RELAUNCH'] = '1';
        if ($xdebug) {
            $env['XDEBUG_MODE'] = 'off';
        }
        $ini = $jit ? ['-d', 'opcache.enable_cli=1', '-d', 'opcache.jit=tracing', '-d', 'opcache.jit_buffer_size=128M'] : [];
        pcntl_exec(PHP_BINARY, [...$ini, $_SERVER['argv'][0], ...array_slice($_SERVER['argv'], 1)], $env);
        // Only reached if exec failed: carry on unchanged.
    }
}

$limit = ini_get('memory_limit');
$bytes = (int) $limit * match (strtolower(substr((string) $limit, -1))) { 'g' => 1 << 30, 'm' => 1 << 20, 'k' => 1 << 10, default => 1 };
if ($bytes > 0 && $bytes < (1 << 30)) {
    ini_set('memory_limit', '1G');
}

// Never load the project's vendor/autoload.php: it runs every package's
// autoload.files, which is exactly where a backdoored dependency hides
// (the Laravel-Lang attack). Load only ankus and nikic/php-parser, by path.
$parserDir = null;
foreach ([__DIR__ . '/../vendor/nikic/php-parser/lib/PhpParser', __DIR__ . '/../../../nikic/php-parser/lib/PhpParser'] as $candidate) {
    if (is_dir($candidate)) {
        // realpath() does not work inside a PHAR, so keep the path as is there.
        $parserDir = realpath($candidate) ?: $candidate;
        break;
    }
}
if ($parserDir === null) {
    fwrite(STDERR, "ankus: nikic/php-parser not found. Run `composer install` in the ankus directory.\n");
    exit(2);
}
spl_autoload_register(static function (string $class) use ($parserDir): void {
    [$prefix, $base] = match (true) {
        str_starts_with($class, 'Ankus\\') => ['Ankus\\', __DIR__ . '/../src'],
        str_starts_with($class, 'PhpParser\\') => ['PhpParser\\', $parserDir],
        default => [null, null],
    };
    if ($prefix !== null) {
        $file = $base . '/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
        if (is_file($file)) {
            require $file;
        }
    }
});
if (!class_exists(PhpParser\Node\Scalar\Int_::class)) {
    fwrite(STDERR, "ankus: needs nikic/php-parser 5.x, found an older version at $parserDir. Install ankus standalone (see README).\n");
    exit(2);
}

exit((new Ankus\Cli())->run($_SERVER['argv']));
